# ─────────────────────────────────────────────────────────
#  .env.example — HealthTrack360 AI (Application/backend)
#  Copy this file → rename to .env → fill in your values
#  ⚠️  NEVER commit .env to GitHub
# ─────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ───────────────────────────────────────
# 1. Go to https://cloud.mongodb.com
# 2. Create free M0 cluster
# 3. Network Access → Add IP → 0.0.0.0/0 (allow all — needed for Railway)
# 4. Connect → Drivers → copy connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/healthtrack360_app

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=your_super_strong_random_secret_key_min_32_chars
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────
# Your deployed frontend URL (leave * to allow APK + all origins)
CLIENT_URL=*

# ─── AI (Anthropic) ──────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
